.{
    .name = .snek,
    .version = "0.0.0",
    // Generated for this package; changing it has security and trust
    // implications. Regenerate only when forking.
    .fingerprint = 0xd86d11765e7ad5eb,
    .minimum_zig_version = "0.17.0",
    // `snek` is deliberately dependency-free. The two things it needs from
    // outside its own tree - a small `util` subset and nothing else - are
    // vendored under `lib/util/`, because the monorepo it was extracted from
    // consumes `snek` and a back-edge would be a package cycle.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // `b.path()` is relative to the build root, so these three directories
        // are the whole compile input: the shared target policy, the four
        // libraries and the two binaries.
        "build",
        "lib",
        "app",
    },
}
